{
  "manifest_version": 3,
  "name": "Internet Video Download Assistant",
  "version": "1.0.0",
  "description": "IDM tarzında web sayfalarındaki videoları otomatik tespit edip yüksek kalitede indiren video indirme yardımcısı.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Internet Video Download Assistant"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "webRequest",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/modules/PlayerLocator.js",
        "content/modules/VideoOverlayPresenter.js",
        "content/modules/DomMediaScanner.js",
        "content/content.js"
      ],
      "css": [
        "content/styles/video-overlay.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "content/styles/video-overlay.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
